{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PUO-AI Lexicon",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "entry_id",
      "headword_english",
      "pos",
      "headword_sesotho",
      "syllables",
      "morphology",
      "senses",
      "thesaurus"
    ],
    "properties": {
      "entry_id": {
        "type": "string",
        "minLength": 1
      },
      "headword_english": {
        "type": "string"
      },
      "pos": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "headword_sesotho": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "orthographic",
            "tone_marked",
            "ipa",
            "tone_pattern"
          ],
          "properties": {
            "orthographic": {
              "type": "string"
            },
            "tone_marked": {
              "type": "string"
            },
            "ipa": {
              "type": "string"
            },
            "tone_pattern": {
              "type": "string"
            }
          },
          "additionalProperties": true
        }
      },
      "syllables": {
        "type": "array",
        "items": {
          "type": "string"
        }
      },
      "morphology": {
        "type": "object",
        "required": [
          "root",
          "derivation",
          "noun_class"
        ],
        "properties": {
          "root": {
            "type": "string"
          },
          "derivation": {
            "type": "string"
          },
          "noun_class": {
            "type": "string"
          }
        },
        "additionalProperties": true
      },
      "senses": {
        "type": "array",
        "items": {
          "type": "object",
          "required": [
            "sense_id",
            "definition_en",
            "sesotho_term"
          ],
          "properties": {
            "sense_id": {
              "type": "string",
              "minLength": 1
            },
            "definition_en": {
              "type": "string"
            },
            "definition_st": {
              "type": "string"
            },
            "sesotho_term": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "additionalProperties": true
        }
      },
      "thesaurus": {
        "type": "object",
        "required": [
          "synonyms_en",
          "antonyms_en",
          "synonyms_st",
          "antonyms_st"
        ],
        "properties": {
          "synonyms_en": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "antonyms_en": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "synonyms_st": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "antonyms_st": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      },
      "related_words": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "additionalProperties": true
  }
}
